# ==============================================================================
# JOB MAPPER ENVIRONMENT CONFIGURATION
# ==============================================================================

# Port & App Configuration
PORT=3000
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Configuration
# Leave DATABASE_URL empty or unset for local SQLite with spatial queries (zero-config)
# For production PostgreSQL with PostGIS: postgresql://user:password@localhost:5432/jobmapper
DATABASE_URL=
SQLITE_DB_PATH=./jobmapper.db

# Admin Secret / Token for Admin Dashboard & Ingestion endpoints
ADMIN_SECRET_KEY=jobmapper_admin_secret_key_change_in_production

# Geocoding Service Configuration
# Default is 'nominatim' (OpenStreetMap) with fallback to 'photon'
GEOCODING_PROVIDER=nominatim
GEOCODING_USER_AGENT=JobMapper/1.0 (contact@jobmapper.local)
# Optional OpenCage API Key if using opencage provider
OPENCAGE_API_KEY=

# AI Provider Configuration
# Options: 'rule_based' (default, offline, zero-cost, anti-hallucination) | 'gemini' | 'openai'
AI_PROVIDER=rule_based
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Map Configuration
# Map tile choices: 'osm' (OpenStreetMap) | 'carto_voyager' | 'carto_positron'
NEXT_PUBLIC_MAP_TILE_PROVIDER=carto_voyager
NEXT_PUBLIC_THUNDERFOREST_KEY=

